# Заполняется автоматически мастером первого запуска (scripts/setup.py),
# либо вручную скопируйте в .env и заполните значения.

# --- Telegram ---
BOT_TOKEN=
OWNER_ID=

# --- Webhook (production) ---
USE_WEBHOOK=true
WEBHOOK_DOMAIN=
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# --- PostgreSQL ---
POSTGRES_URL=postgresql+asyncpg://user:password@localhost:5432/car_auction_bot

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Docker Compose (необязательно) ---
# Пароль PostgreSQL для контейнера db (по умолчанию: password). База наружу не публикуется.
# POSTGRES_PASSWORD=

# --- Misc ---
RUN_MIGRATIONS=true
ENV=production
LOG_LEVEL=INFO
DEFAULT_LANGUAGE=ru
