# ===== Перенос бота на свой сервер =====
# Скопируйте этот файл в deploy/server.env и заполните. server.env в git НЕ попадает —
# пароль и токен остаются только у вас. В чат их не отправляйте.

# --- сервер (Ubuntu / Debian) ---
SERVER_IP=
SERVER_USER=root
SSH_PORT=22
# пароль от сервера в одинарных кавычках, например SERVER_PASSWORD='Abc$123'; если входите по SSH-ключу — оставьте пустым
SERVER_PASSWORD=

# --- бот ---
# токен из @BotFather (/mybots → бот → API Token)
BOT_TOKEN=
BOT_USERNAME=binaiobot

# --- адрес мини-приложения (нужен HTTPS) ---
# свой домен, направленный на SERVER_IP (A-запись), например game.example.com.
# Пусто — будет бесплатный адрес вида 1.2.3.4.sslip.io с сертификатом Let's Encrypt.
DOMAIN=
