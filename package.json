{
  "name": "car-auction",
  "private": true,
  "type": "module",
  "dependencies": {
    "sdk": "file:server/sdk"
  },
  "devDependencies": {
    "@tgcloud/cli": "^0.2.0"
  },
  "scripts": {
    "deploy": "npm run build:web && tgcloud push",
    "status": "tgcloud status",
    "test": "node --test --no-warnings test/*.test.js",
    "build:web": "npm --prefix web run build",
    "art": "node web/scripts/render-art.mjs",
    "server": "node --no-warnings server/main.js"
  }
}
